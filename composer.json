{
    "name": "eclipsephp/common",
    "description": "Common non-opinionated package for Eclipse plugins",
    "keywords": [
        "eclipse",
        "filament",
        "plugin",
        "laravel"
    ],
    "homepage": "https://github.com/DataLinx/eclipsephp-common",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DataLinx",
            "email": "info@datalinx.si"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Eclipse\\Common\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "datalinx/php-utils": "^2.5",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "laravel/framework": "^11.0|^12.0",
        "laravel/scout": "^10.14",
        "spatie/laravel-package-tools": "^1.19"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^9.17|^10.11|^11.2",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.1"
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "post-install-cmd": "@setup",
        "post-update-cmd": "@setup",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest --parallel",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "setup": [
            "@php -r \"if (!file_exists('workbench/.env')) { copy('workbench/.env.example', 'workbench/.env'); echo '.env file created from .env.example\\n'; }\"",
            "@php vendor/bin/testbench key:generate --ansi",
            "npm install",
            "@php vendor/bin/testbench filament:assets",
            "@php vendor/bin/testbench package:sync-skeleton",
            "@php vendor/bin/testbench boost:update --ansi",
            "if [ -d workbench/.junie ]; then rsync -a workbench/.junie/ .junie/ && rm -rf workbench/.junie; fi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eclipse\\Common\\CommonServiceProvider"
            ]
        }
    }
}
